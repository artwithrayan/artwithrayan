{
  "name": "rayan-rao-art-production-iteration",
  "version": "5.0.0",
  "description": "Fixed-price art site with Stripe receipts, Printful sync, shipment tracking emails, and production-readiness improvements.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "security:secrets": "node scripts/check-secrets.cjs",
    "security:history": "node scripts/check-secrets.cjs --history",
    "sync:printful": "node scripts/sync-printful.js",
    "export:orders": "node scripts/export-orders.js",
    "auctions": "node scripts/auctions.cjs",
    "preview:auctions": "node tests/preview-auctions.cjs",
    "test:auctions:stripe": "node tests/stripe-auction-sandbox.cjs"
  },
  "dependencies": {
    "better-sqlite3": "latest",
    "dotenv": "latest",
    "express": "latest",
    "helmet": "latest",
    "morgan": "latest",
    "resend": "latest",
    "stripe": "latest",
    "validator": "latest",
    "express-rate-limit": "latest"
  }
}
